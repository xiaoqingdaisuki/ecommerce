# Leave unset to use the public mock.shop catalog and demo cart.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_WEBHOOK_SECRET=
SITE_ORIGIN=http://localhost:3000
# Enable Shopify Inbox in Shopify Admin before turning on the native widget.
SHOPIFY_INBOX_ENABLED=false
SHOPIFY_STOREFRONT_ID=
# Optional hosted customer-account URL, for example your configured account subdomain.
SHOPIFY_ACCOUNT_URL=
